    "silverloupe",
    "silverloupe-prepare",
    "silverloupe-triage",
    "silverloupe-compare",
    "silverloupe-curate",
    "silverloupe-deliver"
  ],
  "runtime_dependencies": [
    "numpy>=2.2,<3",
